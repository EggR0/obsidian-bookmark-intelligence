BILLING_HOST=0.0.0.0
BILLING_PORT=8787
BILLING_DATABASE=/data/billing.sqlite3
PUBLIC_BASE_URL=https://billing.example.com

# Generate a long random value. This is also used by the Polar webhook verifier.
BOOKMARK_INTELLIGENCE_WEBHOOK_SECRET=replace-with-polar-standard-webhook-secret
POLAR_ACCESS_TOKEN=replace-with-polar-organization-access-token
POLAR_SOLO_PRODUCT_ID=replace-with-solo-product-uuid
POLAR_DUO_PRODUCT_ID=replace-with-duo-product-uuid
POLAR_TEAM_PRODUCT_ID=replace-with-team-product-uuid

# Optional email verification and password reset delivery.
REQUIRE_EMAIL_VERIFICATION=1
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=replace-with-secret
SMTP_FROM=Bookmark Intelligence <mailer@example.com>
SMTP_STARTTLS=1
